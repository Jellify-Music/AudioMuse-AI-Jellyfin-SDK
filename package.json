{
	"name": "@jellify-music/audiomuse-ai-jellyfin-sdk",
	"version": "0.1.0",
	"description": "Typed client for the AudioMuse AI endpoints exposed by its Jellyfin plugin, built on @jellyfin/sdk",
	"keywords": [
		"jellyfin",
		"audiomuse",
		"sdk"
	],
	"license": "MIT",
	"author": "Violet Caulfield <violet@cosmonautical.cloud> (https://github.com/anultravioletaurora)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jellify-Music/AudioMuse-AI-Jellyfin-SDK.git"
	},
	"bugs": {
		"url": "https://github.com/Jellify-Music/AudioMuse-AI-Jellyfin-SDK/issues"
	},
	"homepage": "https://github.com/Jellify-Music/AudioMuse-AI-Jellyfin-SDK#readme",
	"type": "module",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"files": [
		"lib",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"@jellyfin/sdk": ">=0.11.0",
		"axios": "^1.12.0"
	},
	"devDependencies": {
		"@jellyfin/sdk": "1.0.2",
		"@types/bun": "1.4.4",
		"axios": "1.20.0",
		"prettier": "3.9.10",
		"typescript": "6.0.3"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"packageManager": "bun@1.4.2"
}
